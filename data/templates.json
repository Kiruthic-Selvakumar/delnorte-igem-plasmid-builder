        {
          "role": "marker",
          "required": true,
          "candidates": [
            "sg_KanR",
            "sg_CmR_(2)"
          ],
          "note": "avoid AmpR - V. natriegens has reported intrinsic beta-lactamase activity"
        },
        {
          "role": "promoter",
          "required": true,
          "candidates": [
            "sg_araBAD_promoter_(2)",
            "sg_lac_promoter"
          ],
          "note": "E. coli sigma-70 promoters transfer to Vibrio (both gamma-proteobacteria)"
