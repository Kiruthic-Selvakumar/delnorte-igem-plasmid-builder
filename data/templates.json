      "assembly": "gibson",
      "notes": "pBBR1 oriV is non-functional without pBBR1 Rep in trans - both slots are required together. Same dependency pattern as ori1030+repA in B. subtilis.",
      "slots": [
        {
          "role": "ori",
          "required": true,
          "candidates": [
            "sg_pBBR1_oriV",
            "sg_RSF1010_oriV",
            "sg_pRO1600_oriV"
          ],
          "requires": {
            "sg_pBBR1_oriV": ["sg_pBBR1_Rep"],
            "sg_RSF1010_oriV": ["sg_RSF1010_RepA", "sg_RSF1010_RepB", "sg_RSF1010_RepC"],
            "sg_pRO1600_oriV": ["sg_pRO1600_Rep"]
          },
          "note": "each oriV needs its own cognate Rep; the rep slot must match the ori chosen here"
        },
        {
          "role": "rep",
          "required": true,
