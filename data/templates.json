{
  "schema_version": 1,
  "note": "Slot order defines transcription order 5'->3'. Backbone slots (ori, marker) sit outside the expression cassette but are part of the circular plasmid.",
  "templates": [
    {
      "id": "ecoli_inducible",
      "host": "E. coli",
      "label": "E. coli inducible expression",
      "assembly": "gibson",
      "slots": [
        {
          "role": "ori",
          "required": true,
          "candidates": [
            "sg_ori",
            "sg_p15A_ori",
            "sg_pSC101_ori"
          ],
          "requires": {
            "sg_pSC101_ori": ["sg_Rep101"]
          },
          "note": "ColE1 and p15A replicate autonomously; pSC101 needs Rep101 in trans"
        },
        {
          "role": "marker",
          "required": true,
          "candidates": [
            "sg_KanR",
            "sg_CmR_(2)",
            "sg_AmpR"
          ]
        },
        {
          "role": "promoter",
          "required": true,
          "candidates": [
            "sg_araBAD_promoter_(2)",
            "sg_lac_promoter"
          ]
        },
        {
          "role": "rbs",
          "required": true,
          "candidates": [
            "sg_RBS_(2)",
            "sg_Shine_Dalgarno_sequence"
          ]
        },
        {
          "role": "signal",
          "required": false,
          "candidates": []
        },
        {
          "role": "cds",
          "required": true,
          "candidates": [],
          "user_supplied": true
        },
        {
          "role": "terminator",
          "required": true,
          "candidates": [
            "sg_rrnB_T1_terminator",
            "sg_T7Te_terminator"
          ]
        }
      ]
    },
    {
